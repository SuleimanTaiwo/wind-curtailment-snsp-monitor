# Python junk
__pycache__/
*.pyc
.ipynb_checkpoints/

# Virtual environments
.venv/
venv/
*-env/

# Data files (large, and can be re-downloaded)
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep
# Secrets such as database passwords
.env

# OS and editor clutter
Thumbs.db
.vscode/

# Generated outputs (recreated by running the pipeline)
data/rejected/
logs/

# Excel temporary lock files (appear while a workbook is open)
~$*